{
  "name": "pikchr-diagram-preview",
  "version": "0.2.0",
  "displayName": "Pikchr Diagram Preview",
  "description": "Adds Pikchr support to VS Code's built-in Markdown preview",
  "keywords": [
    "pikchr",
    "railroad",
    "syntax",
    "markdown",
    "diagram",
    "markdown-preview"
  ],
  "icon": "media/icon.png",
  "publisher": "ReoX86",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reonarudo/pikchr-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Reonarudo/pikchr-markdown-preview/issues"
  },
  "homepage": "https://github.com/Reonarudo/pikchr-markdown-preview#readme",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "media/preview.css"
    ]
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "test:package": "node scripts/test-package.mjs",
    "test:extension": "node scripts/test-extension.mjs"
  },
  "dependencies": {
    "@reonarudo/pikchr-renderer": "https://github.com/Reonarudo/pikchr-renderer/releases/download/v1.0.0/reonarudo-pikchr-renderer-1.0.0.tgz"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.3",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "@vscode/test-electron": "3.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true,
    "fsevents@2.3.3": false
  }
}
